# ─── {{app-name}} UI — Local Dev Environment ─────────────────────────────────
# Copy to .env for local development. The docker-compose mounts this automatically.
# NEVER commit .env with real credentials.
#
# When running via ./dev.sh the backend is at http://localhost:8000 by default.
# The UI container automatically uses VITE_API_URL set here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (must match PORT_BACKEND in dev.sh / docker-compose.local.yml)
VITE_API_URL=http://localhost:8000/v1

# Cognito — not needed here for local dev; auth is handled by the backend.
# These are injected at deploy time by the reusable static-site workflow.
# VITE_USER_POOL_ID={{cognito-user-pool-id}}
# VITE_USER_POOL_CLIENT_ID={{cognito-client-id}}
# VITE_AWS_REGION={{aws-region}}

# Hosted auth (SSO) — OPTIONAL. When VITE_AUTH_DOMAIN is set the login page
# redirects to the central Cognito Managed Login (OAuth2 code + PKCE) instead
# of the password form. Requires VITE_USER_POOL_CLIENT_ID above, and the app
# client must allow the code grant with callback {origin}/auth/callback.
# Leave unset to keep the classic password-form login.
# VITE_AUTH_DOMAIN=auth.triviz.cloud

# Org door (portal) host for the header app-switcher — OPTIONAL. When unset
# the switcher derives it from the current host by dropping its first label
# (myapp.triviz.cloud → portal.triviz.cloud). No scheme.
# VITE_PORTAL_ORG_HOST=portal.triviz.cloud
